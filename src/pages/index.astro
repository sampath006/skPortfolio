---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Avatar from '../layouts/Avatar.astro';
import { profile, loadProjects } from '../lib/profile';

const projects = await loadProjects();

// Photos live in src/assets so the build can resize and compress them.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;
const galleryFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const gallery = profile.gallery
  .map((g) => ({ ...g, img: galleryFiles[`../assets/gallery/${g.file}`]?.default }))
  .filter((g) => g.img);

const headline = profile.pitch.split(' ');
const lines: string[] = [];
for (let i = 0; i < headline.length; i += 2) lines.push(headline.slice(i, i + 2).join(' '));
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<Base>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap">
      <a class="me" href="#top">{profile.shortName}</a>
      <nav aria-label="Sections">
        <a href="#experience">Experience</a>
        <a href="#case-studies">Case studies</a>
        <a href="#projects">Projects</a>
        <a href="#beyond">Beyond code</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="btn small" href="/resume/">Resume</a>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <p class="hello">Hi, I'm {profile.shortName}.</p>
            <h1 aria-label={profile.pitch}>
              {lines.map((l, i) => <span aria-hidden="true"><i style={`--i:${i}`}>{l}</i></span>)}
            </h1>
            <p class="where">{profile.location}. {profile.availability && `${profile.availability}.`}</p>
            <ul class="stack" aria-label="Main technologies">
              {profile.stack.map((s) => <li>{s}</li>)}
            </ul>
            <div class="actions">
              <a class="btn" href="/resume/">Read my resume</a>
              <a class="btn ghost" href="#contact">Send me a message</a>
            </div>
          </div>
          <div class="face" data-show={portrait ? 'photo' : 'avatar'}>
            <div class="disc">
              <Avatar />
              {portrait && <Image class="photo" src={portrait} alt={`Photo of ${profile.name}`} width={544} height={544} loading="eager" />}
            </div>
            {portrait && <button class="swap" type="button" aria-pressed="false">Show avatar</button>}
          </div>
        </div>

        <div class="scaler" id="scaler">
          <div>
            <h2>My work in miniature</h2>
            <p>Backup jobs arrive. Compute nodes spin up, register themselves, do the work, then shut down so nobody pays for idle machines.</p>
            <button class="btn small" type="button" id="queue">Queue 8 backup jobs</button>
          </div>
          <div>
            <div class="readout" aria-live="off">
              <span><b id="jobs">0</b>jobs waiting</span>
              <span><b id="nodes">0</b>nodes running</span>
            </div>
            <div class="slots" id="slots" aria-hidden="true">
              {Array.from({ length: 16 }).map(() => <i />)}
            </div>
            <div class="legend" aria-hidden="true">
              <span style="--k:var(--amber)">Registering</span>
              <span style="--k:var(--cyan)">Running</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band about" id="about">
      <div class="wrap">
        <p>{profile.about}</p>
      </div>
    </section>

    <section class="band" id="experience">
      <div class="wrap">
        <h2>Experience</h2>
        <div class="jobs">
          {profile.experience.map((job) => (
            <article class="job">
              <p class="when">{job.start} to {job.end}</p>
              <div>
                <h3>{job.role}</h3>
                <p class="org">{job.company}{job.place && `, ${job.place}`}</p>
                {job.bullets.length > 0 && <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band cases" id="case-studies">
      <div class="wrap">
        <h2>Case studies</h2>
        {profile.caseStudies.map((c, i) => (
          <details class="case" open={i === 0}>
            <summary>
              <h3>{c.title}</h3>
              <p>{c.summary}</p>
              <span class="toggle" aria-hidden="true"></span>
            </summary>
            <div class="body">
              <div><h4>The problem</h4><p>{c.problem}</p></div>
              <div><h4>What I did</h4><p>{c.approach}</p></div>
              <div><h4>The result</h4><p>{c.result}</p></div>
              {c.tags.length > 0 && <ul class="tags">{c.tags.map((t) => <li>{t}</li>)}</ul>}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="band" id="projects">
      <div class="wrap">
        <h2>Projects</h2>
        <div class="projects">
          {projects.map((p) => (
            <article class="project">
              <h3>{p.url ? <a href={p.url} rel="noopener">{p.name}</a> : p.name}</h3>
              <p>{p.description}</p>
              {p.tags.length > 0 && <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band proof" id="achievements">
      <div class="wrap">
        <h2>Achievements</h2>
        <dl class="wins">
          {profile.achievements.map((a) => (
            <div><dt>{a.title}</dt><dd>{a.detail}</dd></div>
          ))}
        </dl>
        <div class="facts">
          <div>
            <h3>Education</h3>
            {profile.education.map((e) => (
              <p><strong>{e.degree}</strong><br />{e.school}, {e.years}{e.detail && <><br /><span class="dim">{e.detail}</span></>}</p>
            ))}
          </div>
          <div>
            <h3>Skills</h3>
            <dl class="skills">
              {profile.skills.map((s) => (
                <div><dt>{s.group}</dt><dd>{s.items.join(', ')}</dd></div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="band beyond" id="beyond">
      <div class="wrap">
        <h2>Beyond code</h2>
        <div class="pursuits">
          {profile.interests.map((it) => (
            <div><h3>{it.title}</h3><p>{it.text}</p></div>
          ))}
        </div>
        {gallery.length > 0 && (
          <div class="gallery">
            {gallery.map((g) => (
              <figure>
                <Image src={g.img!} alt={g.caption || 'Photo by ' + profile.shortName} width={640} />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="band" id="contact">
      <div class="wrap">
        <h2>Contact</h2>
        <div class="contact-grid">
          <div>
            <p class="measure">Hiring for a backend or cloud role, or want to talk about a problem you're stuck on? Write to me and I'll reply by email.</p>
            {profile.timezone && <p class="dim" style="margin-top:0.75rem">I'm on {profile.timezone}.</p>}
            <div class="links">
              {profile.links.github && <a class="btn ghost small" href={profile.links.github} rel="me noopener">GitHub</a>}
              {profile.links.linkedin && <a class="btn ghost small" href={profile.links.linkedin} rel="me noopener">LinkedIn</a>}
              {profile.links.email && <a class="btn ghost small" href={`mailto:${profile.links.email}`}>Email</a>}
            </div>
          </div>
          <form class="contact" id="contact-form" novalidate>
            <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" autocomplete="name" required maxlength="100" /></div>
            <div class="field"><label for="c-email">Your email</label><input id="c-email" name="email" type="email" autocomplete="email" required maxlength="200" /></div>
            <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required maxlength="4000"></textarea></div>
            <div class="trap" aria-hidden="true"><label for="c-co">Company website</label><input id="c-co" name="website" tabindex="-1" autocomplete="off" /></div>
            {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="dark"></div>}
            <div><button class="btn" type="submit">Send message</button></div>
            <p class="note" id="contact-note" role="status"></p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="site">
    <div class="wrap">
      <span>Built by {profile.shortName} with Astro and Cloudflare Pages.</span>
      <span id="visits" hidden></span>
    </div>
  </footer>

  {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    import '../scripts/home.ts';
  </script>
</Base>
