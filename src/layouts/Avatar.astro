---
// A simple original cartoon avatar. Replace this SVG if you commission your own.
---
<svg class="avatar" viewBox="0 0 200 200" role="img" aria-label="Cartoon avatar waving hello">
  <defs>
    <linearGradient id="av-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#173a38" />
      <stop offset="1" stop-color="#ff5e4d" stop-opacity="0.55" />
    </linearGradient>
  </defs>
  <rect width="200" height="200" fill="url(#av-sky)" />
  <!-- pine trees -->
  <path d="M18 200 L34 150 L26 150 L40 118 L54 150 L46 150 L62 200Z" fill="#0a1f1f" opacity="0.7" />
  <path d="M150 200 L163 160 L157 160 L168 134 L179 160 L173 160 L186 200Z" fill="#0a1f1f" opacity="0.7" />
  <!-- waving arm -->
  <g class="hand">
    <path d="M140 160 Q158 138 160 104" stroke="#ffb536" stroke-width="20" stroke-linecap="round" fill="none" />
    <circle cx="161" cy="92" r="13" fill="#c98d64" />
  </g>
  <!-- hoodie -->
  <path d="M40 200 Q42 150 100 146 Q158 150 160 200Z" fill="#ffb536" />
  <path d="M84 148 Q100 168 116 148" fill="none" stroke="#0f2b2a" stroke-width="3" stroke-linecap="round" />
  <!-- neck and head -->
  <rect x="88" y="120" width="24" height="32" rx="10" fill="#b97f58" />
  <ellipse cx="100" cy="92" rx="36" ry="40" fill="#c98d64" />
  <!-- hair -->
  <path d="M63 88 Q58 46 100 46 Q142 46 137 88 Q130 66 100 66 Q72 66 63 88Z" fill="#101a1a" />
  <!-- face -->
  <circle cx="86" cy="94" r="4" fill="#101a1a" />
  <circle cx="114" cy="94" r="4" fill="#101a1a" />
  <path d="M86 110 Q100 123 114 110" fill="none" stroke="#101a1a" stroke-width="3.5" stroke-linecap="round" />
</svg>
